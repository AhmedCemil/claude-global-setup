# Claude usage / 5-hour rate-limit credentials
# ---------------------------------------------
# Used by scripts/claude_limit_percent.py and the save-session-state skill to
# read your current 5h limit %. Fully optional — if absent, the skill still
# saves state, you just won't see the % readout.
#
# SETUP (any machine, no code edit):
#   1. Copy this file to:  ~/.claude/claude_usage.env   (drop the ".example")
#   2. Fill in the three values below from your claude.ai session.
#
# Where the values come from (claude.ai, logged in, DevTools open):
#   SESSION_KEY  -> Application > Cookies > claude.ai > "sessionKey"
#   ORG_ID       -> any /api/organizations/<ORG_ID>/... request URL (Network tab)
#   DEVICE_ID    -> Application > Cookies > claude.ai > device id cookie (optional for the limit call)
#
# These are personal session credentials — DO NOT commit the real file or put it
# in a shared zip. Only this .example (with no real values) belongs in the set.

SESSION_KEY=
DEVICE_ID=
ORG_ID=
